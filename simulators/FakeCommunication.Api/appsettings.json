{
  "Urls": "http://localhost:8086",
  "AllowedHosts": "*",
  "Platform": {
    "Swagger": { "Enabled": true },
    "Cors": { "AllowedOrigins": [] },
    "RateLimit": { "PermitLimit": 2000, "WindowSeconds": 60, "QueueLimit": 0 },
    "Http": { "MaxRequestBodyBytes": 262144, "MaxConcurrentConnections": 3000, "RequestHeadersTimeoutSeconds": 15, "KeepAliveSeconds": 60, "MaxRequestHeaderCount": 64, "MaxRequestHeadersTotalSizeBytes": 32768 },
    "Security": { "EnableHsts": false, "EnableHttpsRedirection": false, "RequireJsonForWriteRequests": true, "RequireInternalServiceKey": true, "InternalServiceKey": "LOCAL-DEV-ONLY-DOWNSTREAM-SERVICE-KEY-CHANGE-ME-1234567890" }
  }
}
