{
  "Urls": "http://0.0.0.0:8080",
  "AllowedHosts": "gateway.finwallet.internal",
  "FinWallet": {
    "Security": {
      "Jwt": {
        "Issuer": "finwallet",
        "Audience": "finwallet-api",
        "SigningKey": ""
      }
    }
  },
  "Gateway": {
    "Security": {
      "InternalServiceKey": "",
      "DownstreamServiceKey": "",
      "JwtClockSkewSeconds": 15
    }
  },
  "Platform": {
    "Swagger": {
      "Enabled": false
    },
    "Cors": {
      "AllowedOrigins": []
    },
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Http": {
      "MaxRequestBodyBytes": 1048576,
      "MaxConcurrentConnections": 10000,
      "RequestHeadersTimeoutSeconds": 10,
      "KeepAliveSeconds": 60,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSizeBytes": 32768
    },
    "Security": {
      "EnableHsts": false,
      "EnableHttpsRedirection": false,
      "RequireJsonForWriteRequests": true
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "FinWalletCluster": {
        "Destinations": {
          "Primary": {
            "Address": "http://finwallet-api:8081/"
          }
        }
      },
      "FakeBankCluster": {
        "Destinations": {
          "Primary": {
            "Address": "http://fake-bank:8082/"
          }
        }
      },
      "FakeFraudCluster": {
        "Destinations": {
          "Primary": {
            "Address": "http://fake-fraud:8083/"
          }
        }
      },
      "FakeCutoffCluster": {
        "Destinations": {
          "Primary": {
            "Address": "http://fake-cutoff:8084/"
          }
        }
      },
      "FakeCampaignCluster": {
        "Destinations": {
          "Primary": {
            "Address": "http://fake-campaign:8085/"
          }
        }
      },
      "FakeCommunicationCluster": {
        "Destinations": {
          "Primary": {
            "Address": "http://fake-communication:8086/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  }
}
