{
  "Urls": "http://localhost:8080",
  "AllowedHosts": "*",
  "FinWallet": {
    "Security": {
      "Jwt": {
        "Issuer": "finwallet-local",
        "Audience": "finwallet-api",
        "SigningKey": "LOCAL-DEV-ONLY-FINWALLET-SIGNING-KEY-CHANGE-ME-1234567890"
      }
    }
  },
  "Gateway": {
    "Security": {
      "InternalServiceKey": "LOCAL-DEV-ONLY-INTERNAL-SERVICE-KEY-CHANGE-ME-1234567890",
      "JwtClockSkewSeconds": 30
    }
  },
  "Platform": {
    "Swagger": {
      "Enabled": true
    },
    "Cors": {
      "AllowedOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ]
    },
    "RateLimit": {
      "PermitLimit": 240,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Http": {
      "MaxRequestBodyBytes": 1048576,
      "MaxConcurrentConnections": 4000,
      "RequestHeadersTimeoutSeconds": 15,
      "KeepAliveSeconds": 60,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSizeBytes": 32768
    },
    "Security": {
      "EnableHsts": false,
      "EnableHttpsRedirection": false,
      "RequireJsonForWriteRequests": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-register": {
        "ClusterId": "FinWalletCluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -100,
        "Match": {
          "Path": "/api/v1/auth/register"
        }
      },
      "auth-registration-verify": {
        "ClusterId": "FinWalletCluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -100,
        "Match": {
          "Path": "/api/v1/auth/registration/verify"
        }
      },
      "auth-login": {
        "ClusterId": "FinWalletCluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -100,
        "Match": {
          "Path": "/api/v1/auth/login"
        }
      },
      "auth-refresh": {
        "ClusterId": "FinWalletCluster",
        "AuthorizationPolicy": "Anonymous",
        "Order": -100,
        "Match": {
          "Path": "/api/v1/auth/refresh"
        }
      },
      "finwallet-api": {
        "ClusterId": "FinWalletCluster",
        "AuthorizationPolicy": "GatewayAuthenticated",
        "Order": 0,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "fake-bank": {
        "ClusterId": "FakeBankCluster",
        "AuthorizationPolicy": "InternalService",
        "Order": 0,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/providers/bank/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/providers/bank"
          }
        ]
      },
      "fake-fraud": {
        "ClusterId": "FakeFraudCluster",
        "AuthorizationPolicy": "InternalService",
        "Order": 0,
        "MaxRequestBodySize": 1048576,
        "Match": {
          "Path": "/providers/fraud/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/providers/fraud"
          }
        ]
      },
      "fake-communication": {
        "ClusterId": "FakeCommunicationCluster",
        "AuthorizationPolicy": "InternalService",
        "Order": 0,
        "MaxRequestBodySize": 262144,
        "Match": {
          "Path": "/providers/communication/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/providers/communication"
          }
        ]
      },
      "fake-cutoff": {
        "ClusterId": "FakeCutoffCluster",
        "AuthorizationPolicy": "InternalService",
        "Order": 0,
        "MaxRequestBodySize": 262144,
        "Match": {
          "Path": "/providers/cutoff/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/providers/cutoff"
          }
        ]
      },
      "fake-campaign": {
        "ClusterId": "FakeCampaignCluster",
        "AuthorizationPolicy": "InternalService",
        "Order": 0,
        "MaxRequestBodySize": 262144,
        "Match": {
          "Path": "/providers/campaign/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/providers/campaign"
          }
        ]
      }
    },
    "Clusters": {
      "FinWalletCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRateHealthPolicy",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpClient": {
          "MaxConnectionsPerServer": 512,
          "EnableMultipleHttp2Connections": true
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30",
          "Version": "2",
          "VersionPolicy": "RequestVersionOrLower",
          "AllowResponseBuffering": false
        },
        "Destinations": {
          "Primary": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "FakeBankCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "HttpClient": {
          "MaxConnectionsPerServer": 256
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:10"
        },
        "Destinations": {
          "Primary": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "FakeFraudCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/live"
          }
        },
        "HttpClient": {
          "MaxConnectionsPerServer": 256
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:05"
        },
        "Destinations": {
          "Primary": {
            "Address": "http://localhost:8083/"
          }
        }
      },
      "FakeCutoffCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "Primary": {
            "Address": "http://localhost:8084/"
          }
        }
      },
      "FakeCampaignCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "Primary": {
            "Address": "http://localhost:8085/"
          }
        }
      },
      "FakeCommunicationCluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "Primary": {
            "Address": "http://localhost:8086/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  }
}
