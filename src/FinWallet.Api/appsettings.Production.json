{
  "Urls": "http://0.0.0.0:8081",
  "AllowedHosts": "finwallet-api.internal",
  "FinWallet": {
    "Sql": {
      "ConnectionString": ""
    },
    "Redis": {
      "ConnectionString": "",
      "AbortOnConnectFail": false,
      "ConnectRetry": 5,
      "ConnectTimeoutMilliseconds": 3000,
      "SyncTimeoutMilliseconds": 3000,
      "KeepAliveSeconds": 60
    },
    "HttpClient": {
      "PooledConnectionLifetimeMinutes": 5,
      "PooledConnectionIdleMinutes": 2,
      "MaxConnectionsPerServer": 512
    },
    "Security": {
      "RegistrationOtpPepper": "",
      "Jwt": {
        "Issuer": "finwallet",
        "Audience": "finwallet-api",
        "SigningKey": "",
        "ClockSkewSeconds": 15,
        "AccessTokenLifetimeMinutes": 10
      }
    },
    "Gateway": {
      "InternalServiceKey": ""
    },
    "Integrations": {
      "FakeCommunication": { "BaseUrl": "http://finwallet-gateway:8080/providers/communication/", "TimeoutSeconds": 3 },
      "FakeFraud": { "BaseUrl": "http://finwallet-gateway:8080/providers/fraud/", "TimeoutSeconds": 2 },
      "FakeBank": { "BaseUrl": "http://finwallet-gateway:8080/providers/bank/", "TimeoutSeconds": 3 },
      "FakeCutoff": { "BaseUrl": "http://finwallet-gateway:8080/providers/cutoff/", "TimeoutSeconds": 3 },
      "FakeCampaign": { "BaseUrl": "http://finwallet-gateway:8080/providers/campaign/", "TimeoutSeconds": 3 }
    }
  },
  "Platform": {
    "Swagger": { "Enabled": false },
    "Cors": { "AllowedOrigins": [] },
    "RateLimit": { "PermitLimit": 4000, "WindowSeconds": 60, "QueueLimit": 0 },
    "Http": {
      "MaxRequestBodyBytes": 1048576,
      "MaxConcurrentConnections": 10000,
      "RequestHeadersTimeoutSeconds": 10,
      "KeepAliveSeconds": 60,
      "MaxRequestHeaderCount": 64,
      "MaxRequestHeadersTotalSizeBytes": 32768
    },
    "Security": {
      "EnableHsts": false,
      "EnableHttpsRedirection": false,
      "RequireJsonForWriteRequests": true,
      "RequireInternalServiceKey": true,
      "InternalServiceKey": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
