# Copy this file to .env for local Docker Compose usage.
# Never commit real production secrets.

COMPOSE_PROJECT_NAME=finwallet

# Infrastructure
MSSQL_SA_PASSWORD=ChangeMe-LocalOnly-StrongPassword!123
REDIS_PASSWORD=ChangeMe-LocalOnly-RedisPassword!123

# Authentication / cryptography
JWT_ISSUER=finwallet-docker
JWT_AUDIENCE=finwallet-api
JWT_SIGNING_KEY=ChangeMe-LocalOnly-FinWallet-Signing-Key-At-Least-32-Bytes
REGISTRATION_OTP_PEPPER=ChangeMe-LocalOnly-Otp-Pepper-At-Least-32-Bytes

# Service-to-service trust boundaries
INTERNAL_SERVICE_KEY=ChangeMe-LocalOnly-Internal-Service-Key-At-Least-32-Bytes
DOWNSTREAM_SERVICE_KEY=ChangeMe-LocalOnly-Downstream-Service-Key-At-Least-32-Bytes

# Optional host ports for local infrastructure/debugging
GATEWAY_PORT=8080
MSSQL_PORT=1433
REDIS_PORT=6379
FINWALLET_API_DEBUG_PORT=8081
FAKE_BANK_DEBUG_PORT=8082
FAKE_FRAUD_DEBUG_PORT=8083
FAKE_CUTOFF_DEBUG_PORT=8084
FAKE_CAMPAIGN_DEBUG_PORT=8085
FAKE_COMMUNICATION_DEBUG_PORT=8086
